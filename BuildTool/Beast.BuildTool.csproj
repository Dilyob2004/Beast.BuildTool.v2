<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Configuration>Release</Configuration>
    <OutputPath>$(MSBuildProjectDirectory)\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <!-- Release builds pass -p:Version=<tag>; local builds are "2.0.0-dev". -->
    <Version>2.0.0-dev</Version>
    <Product>Beast BuildTool</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the C# compiler is needed to compile *.Build.cs / *.Target.cs rules
         (the Microsoft.CodeAnalysis meta-package also pulls in Visual Basic and Workspaces). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />
    <PackageReference Include="Microsoft.VisualStudio.Setup.Configuration.Interop" Version="3.13.2069" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests/ModelTests checks internal planning code (locks, VS generation) without a compiler. -->
    <InternalsVisibleTo Include="ModelTests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Templates\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
